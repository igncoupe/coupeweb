{
  "name": "coupeweb",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "coupeweb", "onAutoForward": "openBrowser", "visibility": "private" } },
  "postCreateCommand": "npm install --ignore-scripts",
  "postStartCommand": "nohup npm start > /tmp/coupeweb.log 2>&1 &"
}
